# ─────────────────────────────────────────────────────────────────────────────
# QuickFit — copie para .env.local e preencha. O .env.local está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cliente (vai para o bundle — só chaves públicas aqui) ────────────────────
# Projeto Supabase do QuickFit, separado do Persona Fit.
VITE_SUPABASE_URL=https://jpgnplzkdbfmjkinfvln.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Scripts locais (NUNCA no bundle) ────────────────────────────────────────
# Usado por seed:catalog. Passa por cima de RLS — trate como senha.
SUPABASE_SERVICE_ROLE=

# Usado por classify (classificação offline do catálogo, uma vez).
ANTHROPIC_API_KEY=

# ── Origem do catálogo: projeto Supabase do Persona Fit, somente leitura ────
# Usado por export:raw. Pegue de app/.env.local do Persona Fit.
APP_SUPABASE_URL=
APP_SUPABASE_SERVICE_ROLE=

# ─────────────────────────────────────────────────────────────────────────────
# Segredos da Edge Function `embellish` NÃO ficam aqui — vão para o Supabase:
#
#   supabase secrets set LLM_API_KEY="<sua chave>"
#   supabase secrets set LLM_BASE_URL="https://api.groq.com/openai/v1"
#   supabase secrets set LLM_MODEL="llama-3.3-70b-versatile"
#   supabase secrets set LLM_NAME="groq"
#
# Trocar de provedor (OpenAI, Together, Cerebras) é trocar estas três — todos
# expõem /chat/completions compatível. Ver docs/plans/, task 17.
# ─────────────────────────────────────────────────────────────────────────────
